# Copy these names to local development or Vercel. Never commit a real API key.
# Keep external calls disabled until the OpenAI billing setup and the approval
# checklist in docs/openai-api-connection-checklist.md are complete.
OPENAI_API_KEY=
AI_EXTERNAL_CALLS_ENABLED=false

# Preview-only failure-ledger validation. Never enable this in Production.
AI_PROVIDER_PREVIEW_FAILURE_TESTS=false

# Web Push public key. The matching private key stays only in Vercel server settings.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@rionlabs.co.kr
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
