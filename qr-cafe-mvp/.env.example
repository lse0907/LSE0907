# Copy these names to local development or Vercel. Never commit a real API key.
# Keep external calls disabled until the OpenAI billing setup and the approval
# checklist in docs/openai-api-connection-checklist.md are complete.
OPENAI_API_KEY=
AI_EXTERNAL_CALLS_ENABLED=false
# Production rollout stays off by default. Public flag is a build-time UI hint;
# server flag and exact HTTPS origin are also required for production access.
NEXT_PUBLIC_MENU_SETUP_ENABLED=false
MENU_SETUP_ENABLED=false
MENU_SETUP_ORIGIN=
# Menu analysis also requires authenticated owner and the
# menu_setup capability in the database AI quota allowlist. Never bypass quotas.
MENU_SETUP_ANALYSIS_ENABLED=false
# Atomic initial import. Apply its SQL migration and verify an empty dedicated
# test store before enabling. Production also requires the rollout gates above.
MENU_SETUP_REGISTRATION_ENABLED=false

# Preview-only failure-ledger validation. Never enable this in Production.
AI_PROVIDER_PREVIEW_FAILURE_TESTS=false

# Web Push public key. The matching private key stays only in Vercel server settings.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@rionlabs.co.kr
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Public hostname embedded in newly created counter/table QR codes.
# Leave empty locally so local QR previews use the current localhost address.
NEXT_PUBLIC_QR_PUBLIC_ORIGIN=https://order.rionlabs.co.kr
